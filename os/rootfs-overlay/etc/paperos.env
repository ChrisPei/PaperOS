# Set to the IPv4 address of your computer after Wi-Fi/USB networking is verified.
PAPEROS_BRIDGE_URL=
PAPEROS_BRIDGE_TOKEN=
PAPEROS_FONT=/usr/share/paperos/NotoSansCJKsc-Regular.otf
PAPEROS_NOTE=/var/lib/paperos/note.txt
# Optional: /dev/input/eventN if automatic discovery chooses the wrong device.
PAPEROS_INPUT_DEVICE=
TZ=CST-8
